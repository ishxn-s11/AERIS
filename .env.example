# ============================================================
# AERIS — environment template
# Copy to `.env` and adjust. NEVER commit a real .env file.
# ============================================================

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=aeris
POSTGRES_PASSWORD=aeris_dev_password
POSTGRES_DB=aeris
# Optional direct SQLAlchemy URL override (tests use sqlite:///...)
# DATABASE_URL=

# --- MQTT (Mosquitto) ---
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_WS_PORT=9001
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=aeris
MQTT_CLIENT_ID=aeris-backend

# --- Backend ---
BACKEND_PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-generate-a-real-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# --- Device health ---
# A device is marked OFFLINE (and a DEVICE_OFFLINE alert is raised) when no
# telemetry has been received for this long.
DEVICE_OFFLINE_AFTER_SECONDS=60
DEVICE_HEALTH_CHECK_INTERVAL_SECONDS=20

# --- Frontend (Phase 3) ---
FRONTEND_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

# --- Simulator (defaults for `python simulator.py`) ---
SIM_MQTT_HOST=localhost
SIM_MQTT_PORT=1883
SIM_PUBLISH_INTERVAL_SECONDS=2

# --- Redis (optional) — alert fan-out bus --------------------
# Unset/empty => alerts are fanned out in-process (fine for one backend).
# REDIS_URL=redis://localhost:6379/0
REDIS_URL=
ALERT_FANOUT_CHANNEL=aeris:alerts

# --- Notification channels (email / SMS) ---------------------
# Both default to OFF: nothing is sent until a channel is enabled AND has
# recipients. SMS only fires for CRITICAL by default.
NOTIFY_EMAIL_ENABLED=false
NOTIFY_EMAIL_MIN_SEVERITY=high
NOTIFY_EMAIL_RECIPIENTS=
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
NOTIFY_EMAIL_FROM=aeris-alerts@example.com

NOTIFY_SMS_ENABLED=false
NOTIFY_SMS_MIN_SEVERITY=critical
NOTIFY_SMS_RECIPIENTS=
SMS_WEBHOOK_URL=
SMS_AUTH_TOKEN=
NOTIFY_SMS_FROM=AERIS

# --- Device authentication -----------------------------------
# false = production posture: a node must be pre-registered before its
# telemetry is trusted (register via POST /api/security/devices/register).
DEVICE_AUTO_PROVISION=true
# true = the HTTP telemetry path must also carry the device's auth_token.
DEVICE_AUTH_REQUIRED=false
# Optional: deterministic demo secrets `<value>-<DEVICE_ID>` for seeded devices
# so the broker passwd file can be regenerated without re-flashing.
DEVICE_DEFAULT_PASSWORD=

# --- Forecasting (+N minute projection) ----------------------
ML_FORECAST_MODEL_PATH=app/ml/model_store/aeris_forecast.joblib
FORECAST_HORIZON_MINUTES=10
FORECAST_MIN_CONFIDENCE=0.5
